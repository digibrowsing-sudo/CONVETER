# FileForge Nginx site config.
# Copy to /etc/nginx/sites-available/fileforge, adjust server_name/root,
# then: ln -s ../sites-available/fileforge /etc/nginx/sites-enabled/
#       nginx -t && systemctl reload nginx
# Once a domain points here, run certbot --nginx for SSL.

server {
    listen 80;
    listen [::]:80;
    server_name _;  # replace with your domain, e.g. fileforge.in

    root /var/www/fileforge/frontend/dist;
    index index.html;

    # Above the app's largest per-tool cap (100 MB for browser-side tools that
    # fall back to the server) so the app, not Nginx, produces the friendly
    # "file too large" error with the right limit in it.
    client_max_body_size 105M;

    gzip on;
    gzip_vary on;
    gzip_types text/plain text/css application/javascript application/json application/xml image/svg+xml;

    # Security headers are set by the API for /api responses; these cover the
    # static pages (spec 12.6). 'wasm-unsafe-eval' is what lets the Tier C
    # engines run in the browser at all, and worker-src covers the Web Worker
    # they run inside.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;
    add_header Cross-Origin-Embedder-Policy "require-corp" always;

    # API -> Express on 8095
    location /api/ {
        proxy_pass http://127.0.0.1:8095;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 200s;   # S2 conversions have a 180s ceiling
        proxy_request_buffering off;  # stream uploads so size limits bite early
    }

    # Hashed build assets can be cached forever.
    location /assets/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    location = /sitemap.xml { expires 1h; }
    location = /robots.txt  { expires 1d; }

    # Every route is prerendered to <route>/index.html at build time (spec
    # 14.3), so serve that file when it exists and fall back to the SPA shell
    # only for paths the build did not produce.
    location / {
        try_files $uri $uri/index.html $uri/ /index.html;
    }
}
