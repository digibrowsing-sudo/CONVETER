{
  "name": "fileforge-backend",
  "private": true,
  "version": "0.1.0",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "worker:doc": "node src/queue/worker-entry.js doc",
    "worker:finance": "node src/queue/worker-entry.js finance",
    "test": "npm run test:node && npm run test:python",
    "test:node": "node --test \"test/*.test.js\"",
    "test:python": "python3 -m unittest discover -s python/tests -q"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "bullmq": "^5.80.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.0.0",
    "ioredis": "^5.11.1",
    "multer": "^2.2.0",
    "sharp": "^0.33.5",
    "zod": "^3.25.76"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "supertest": "^7.2.2"
  }
}
