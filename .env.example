# Copy to .env and fill in. Secrets live here or in Coolify's env manager —
# never in the repo (spec 11.2).

NODE_ENV=production
PORT=8095
PUBLIC_WEB_URL=https://fileforge.in
REDIS_URL=redis://127.0.0.1:6379
STORAGE_ROOT=./storage
LOG_LEVEL=info

# REQUIRED in production — the API refuses to start without it, because a
# missing value would make download tokens forgeable.
# Generate with: openssl rand -hex 32
DOWNLOAD_SIGNING_SECRET=
# Long-lived secret for hashing IP addresses. The daily component is derived
# from the date, so this does not need rotating by cron.
IP_HASH_SALT=

# Absolute ceiling. Per-tool caps come from shared/tools.json and are lower.
MAX_UPLOAD_BYTES=104857600
MAX_PDF_PAGES=500
ENGINE_MEMORY_LIMIT_MB=1024

# Retention (spec 10.2). These are a promise to users, not a tuning knob —
# the privacy policy quotes them.
TTL_STANDARD_MINUTES=60
TTL_FINANCE_MINUTES=15
TTL_FAILED_MINUTES=15
DOWNLOAD_TOKEN_TTL_MINUTES=60

# Backpressure and rate limits (spec 8.3, 12.5). Tier C is unlimited: it runs
# in the user's browser and costs us nothing.
QUEUE_DEPTH_LIMIT=25
RL_BURST_MAX=5
RL_SERVER_HOURLY=15
RL_SERVER_DAILY=60
RL_FINANCE_HOURLY=5
RL_FINANCE_DAILY=20
RL_BYTES_DAILY_MB=200

# Reaper (spec 10.3)
REAPER_INTERVAL_MINUTES=5
DISK_WARN_PERCENT=75
DISK_PURGE_PERCENT=80

# Alerting reuses the Telegram bot already on the VPS (spec 13.3). Optional —
# without it, alerts are logged only.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
